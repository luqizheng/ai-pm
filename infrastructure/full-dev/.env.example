# examples/docker-deploy-full/.env.example —— 全栈部署单元的环境模板
# ─────────────────────────────────────────────────────────────────────────────
# 用法：cp .env.example .env 后按环境改值（本文件入库无凭据；.env 不入库）。
#
# 本单元 = infra + observability + services 三片合一（单机全栈）。
# 镜像引用**不在这里**：同目录 .image.env（平台镜像段机器生成、基础镜像段手工维护）。
#
# 跨主机分置部署（模式 C）：把 CONSUL_ADDR / REDIS_HOST / RABBITMQ_HOST /
# DATABASE_URL / OTEL_EXPORTER_OTLP_ENDPOINT 改指各机 IP，SERVICE_ADDRESS 填本机
# LAN IP（consul 健康检查回拨地址）。同机部署全部留容器名默认即可。
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务发现与自注册（跨主机改 IP）──
CONSUL_ADDR=http://consul:8500
# 同机部署留空（回退容器 hostname）；跨主机填本机 LAN IP
SERVICE_ADDRESS=

# ── PostgreSQL（infra 片）──
# 连接串由下面 POSTGRES_* 组装（compose --env-file 与 bash source 均支持 ${...} 插值）。
# 约束：POSTGRES_* 必须写在本行之前；密码进 URL，不得含 @ : / ? #（需 URL 编码）。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_BY_OPS__
POSTGRES_DB=postgres
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis（infra 片）──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASES=16
REDIS_PASSWORD=

# ── RabbitMQ（infra 片）──
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=__SET_BY_OPS__

# ── 可观测（observability 片）──
# 同机走容器名；跨主机填 obs 机 IP（obs 缺席时导出失败不阻塞业务）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__SET_BY_OPS__

# ── 对象存储 RustFS（S3 兼容，附件与大产物的权威存储）──
# RUSTFS_PUBLIC_ENDPOINT = 浏览器与容器都要能解析的**同一个**地址：
# 预签名把 host 写进 SigV4 签名，两端不一致签名即失效（403 SignatureDoesNotMatch）。
#
# 默认用独立主机名 rustfs.local：容器侧由 compose 的 extra_hosts 指到宿主网关
# （rustfs.local:host-gateway）→ 命中宿主发布的 9000；浏览器侧需要 hosts/DNS
# 把它指到同一端口：
#   本机 dev：hosts 加一行 `127.0.0.1 rustfs.local`
#   客户端机器（跨主机）：hosts/DNS 加 `<应用机 LAN IP> rustfs.local`
# 若部署环境已有可解析的域名，直接换成该域名更省事（例：https://s3.ai-pm.corp）
RUSTFS_PUBLIC_ENDPOINT=http://rustfs.local:9000
RUSTFS_ACCESS_KEY=__SET_BY_OPS__
RUSTFS_SECRET_KEY=__SET_BY_OPS__
RUSTFS_BUCKET=ai-pm
RUSTFS_REGION=us-east-1
# 浏览器直传直取的来源白名单；多前端域名时逗号分隔
RUSTFS_CORS_ALLOWED_ORIGINS=*

# ── 栈内互访常量（容器名 DNS，同机恒定）──
TENANT_ID=1
JWKS_URL=http://token-service:8082/.well-known/jwks.json

# ── Service-JWT bootstrap tokens（生产强随机）──
IAM_DEV_BT=__SET_BY_OPS__
TOKEN_DEV_BT=__SET_BY_OPS__
NOTIFICATION_DEV_BT=__SET_BY_OPS__
AUDIT_DEV_BT=__SET_BY_OPS__
PRUE_DEV_BT=__SET_BY_OPS__
GATEWAY_DEV_BT=__SET_BY_OPS__
FILE_DEV_BT=__SET_BY_OPS__
# pm-api 的文件代理凭据（ai-pm 片消费）；必须同时进 token-service 白名单
PM_DEV_BT=__SET_BY_OPS__
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${FILE_DEV_BT},${PM_DEV_BT}
