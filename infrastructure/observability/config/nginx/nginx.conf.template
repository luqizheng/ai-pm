# nginx.conf.template — rendered by consul-template.
# Variables:
#   {{ range services }}{{ .Name }}{{ end }}  → list of service names
#   {{ range service "NAME" }}{{ .Address }}:{{ .Port }}{{ end }}  → upstream instances
#   Stable: services without `canary` tag; Canary: services with `canary` tag

server {
    listen 80;
    server_name localhost;

    location /health {
        return 200 '{"status":"ok"}';
        add_header Content-Type application/json;
    }

    # Canary/stable 上游按服务清单渲染。ai-pm 栈不含 lmms 业务服务
    # （audit/iam/token/... 的 canary 分流属 lmms 侧编排），清单置空；
    # 本栈也无 nginx 容器消费该模板（consul-template 只渲染不 reload，
    # 见 consul-template.hcl）。置空时整段不渲染，结构保留供将来启用。
    {{ $services := "" }}{{ if $services }}{{ range $svc := split " " $services }}
    {{ $var := $svc | replaceAll "-" "_" }}
    upstream {{ $svc }}-stable {
        {{ range service $svc }}{{ if not (.Tags | contains "canary") }}
        server {{ .Address }}:{{ .Port }};
        {{ end }}{{ end }}
    }

    upstream {{ $svc }}-canary {
        {{ range service $svc }}{{ if .Tags | contains "canary" }}
        server {{ .Address }}:{{ .Port }};
        {{ end }}{{ end }}
    }

    # split_clients routes traffic by hashed request_id.
    # nginx variable names must be [A-Za-z0-9_] only — use $var with dashes
    # replaced by underscores.
    split_clients $request_id ${{ $var }}_backend {
        {{- if service (printf "canary.%s" $svc) }}
        10%   {{ $svc }}-canary;
        *     {{ $svc }}-stable;
        {{- else }}
        *     {{ $svc }}-stable;
        {{- end }}
    }
    {{ end }}{{ end }}

    # /api 前缀剥离后转 pm-api（与 frontend vite proxy 的 /api → PM_API_URL 同口径；
    # prod 公共入口 aipm-web:8091 的 /api 反代走 aipm-bff，是另一镜像内的 nginx，
    # 不用本模板）。
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://pm-api:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Canary $http_x_canary;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}
