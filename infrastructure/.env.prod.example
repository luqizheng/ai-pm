# infrastructure/.env.prod.example
# ─────────────────────────────────────────────────────────────────────────────
# Production 环境变量模板。复制为 infrastructure/.env.prod 后按 ops 实际值填写。
# `.env.prod` 已在 .gitignore 中，禁止提交。
#
# 加载顺序：start-prod.sh 先 source .env（dev 默认值），再 source .env.prod（覆盖）。
# 若 .env.prod 不存在 → 报错退出，**不会**回退到 dev 默认值。
#
# 方言：本编排是 PG 形态 —— postgres 为默认库；mysql 降为 profiles:["mysql"]，
# 启用时（--profile mysql）另补 MYSQL_ROOT_PASSWORD / MYSQL_DATABASE /
# MYSQL_USER / MYSQL_PASSWORD（默认不配置，mysql 不启动）。
#
# 命名空间约定：
#   POSTGRES_*   — 主库配置（必须在 DATABASE_URL 之前定义，source 展开依赖顺序）
#   DATABASE_URL — 业务库连接串
#   REDIS_* / RABBITMQ_* / CONSUL_* — 中间件，容器名互访
#   TOKEN_* / JWKS_* / *_DEV_BT     — lmms 鉴权栈联动用，本栈 start-prod.sh 不校验
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL 主库（须在 DATABASE_URL 之前）──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_BY_OPS__
POSTGRES_DB=coder
POSTGRES_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# 业务库连接串 — service-jwt 用户用此连接
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ── Redis / RabbitMQ / Consul 容器内部可达，无需 host bind ──
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=__SET_BY_OPS__
CONSUL_HOST=consul

# ── 服务发现 & JWT（lmms 鉴权栈联动：token-service / iam-service 在 lmms 仓起，
#    pm-api 的 AI_PM_JWKS_URL 指向同网络的 token-service）──
TOKEN_SERVICE_URL=http://token-service:8082
JWKS_URL=http://token-service:8082/.well-known/jwks.json
TENANT_ID=1

# ── Service-JWT bootstrap tokens —— lmms 栈用，本栈 start-prod.sh 不校验 ──
# prod 必须强随机；lmms 仓侧的 start-prod.sh 会校验非空且非 __SET_BY_OPS__。
IAM_DEV_BT=__SET_BY_OPS__
TOKEN_DEV_BT=__SET_BY_OPS__
NOTIFICATION_DEV_BT=__SET_BY_OPS__
AUDIT_DEV_BT=__SET_BY_OPS__
PRUE_DEV_BT=__SET_BY_OPS__
GATEWAY_DEV_BT=__SET_BY_OPS__
CONFIG_DEV_BT=__SET_BY_OPS__
FILE_DEV_BT=__SET_BY_OPS__

# token-service 进程内允许的 bootstrap token 清单（CSV），由各 service-jwt 服务自举握手使用
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${CONFIG_DEV_BT},${FILE_DEV_BT}
