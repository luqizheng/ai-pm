# infrastructure/.env.prod.example
# ─────────────────────────────────────────────────────────────────────────────
# Production 环境变量模板。复制为 infrastructure/.env.prod 后按 ops 实际值填写。
# `.env.prod` 已在 .gitignore 中，禁止提交。
#
# 加载顺序：start-prod.sh 先 source .env-infra（lmms 层固定配置，入库随模板升级
# 覆盖），再 source .env（dev 默认值），最后 source .env.prod（覆盖）。
# 若 .env.prod 不存在 → 报错退出，**不会**回退到 dev 默认值。
#
# 方言：本编排是 PG 形态 —— postgres 为默认库；mysql 降为 profiles:["mysql"]，
# 启用时（--profile mysql）另补 MYSQL_ROOT_PASSWORD / MYSQL_DATABASE /
# MYSQL_USER / MYSQL_PASSWORD（默认不配置，mysql 不启动）。
#
# 命名空间约定：
#   POSTGRES_*   — 主库配置（必须在 DATABASE_URL 之前定义，source 展开依赖顺序）
#   DATABASE_URL — 业务库连接串
#   REDIS_* / RABBITMQ_* / CONSUL_* — 中间件，容器名互访
#   *_DEV_BT       — lmms 鉴权栈 bootstrap tokens（TOKEN_*/JWKS_*/TENANT_ID 在
#                    .env-infra，环境无关，勿在此重复）
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL 主库（须在 DATABASE_URL 之前）──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_BY_OPS__
POSTGRES_DB=coder
POSTGRES_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# 业务库连接串 — service-jwt 用户用此连接
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ── Redis / RabbitMQ / Consul 容器内部可达，无需 host bind ──
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=__SET_BY_OPS__
CONSUL_HOST=consul

# ── 服务发现 & JWT：TOKEN_SERVICE_URL / JWKS_URL / TENANT_ID 在 .env-infra ──
# （lmms 栈内常量，环境无关；此处勿重复，避免覆盖漂移）

# ── 跨机接入（T-081）——机器相关，不是密钥，须按本机对外地址填写 ──
# /mcp 的 rmcp Host 白名单：只写 host 表示不限端口，写 host:port 则端口须精确匹配。
# 留空 = 只接受回环 Host（跨机接入会被 403 拒）。test-server overlay 用 `:?` 强制非空。
AI_PM_MCP_ALLOWED_HOSTS=
# 接入指引（/install/{tool}）里的平台地址——会推导成 MCP 客户端的 Host 头。
AI_PM_PUBLIC_BASE_URL=

# ── Run 调度（ai-pm-worker 第四条循环，Slice D1/D3）──
# 无人值守派发开关：off（默认）/ probe / on。仅门控 worker 领取新 Run；
# 租约健康检查与过期回收持续运行，不受此开关影响（R4）。
AI_PM_RUN_DISPATCH=off
# D-1=b：无人值守派发排除的项目 code 列表（逗号分隔）。命中项 worker 静默跳过，
# 领取型 Runner 的项目用它隔离（如 e2e-acp09）。缺省空 = 行为不变。
# Model A（pm_claim_task / Runner 显式领取）永不受本列表约束。
AI_PM_RUN_DISPATCH_EXCLUDE_PROJECTS=

# ── Service-JWT bootstrap tokens —— lmms 栈用，本栈 start-prod.sh 不校验 ──
# prod 必须强随机；lmms 仓侧的 start-prod.sh 会校验非空且非 __SET_BY_OPS__。
IAM_DEV_BT=__SET_BY_OPS__
TOKEN_DEV_BT=__SET_BY_OPS__
NOTIFICATION_DEV_BT=__SET_BY_OPS__
AUDIT_DEV_BT=__SET_BY_OPS__
PRUE_DEV_BT=__SET_BY_OPS__
GATEWAY_DEV_BT=__SET_BY_OPS__
FILE_DEV_BT=__SET_BY_OPS__

# token-service 进程内允许的 bootstrap token 清单（CSV），由各 service-jwt 服务自举握手使用
PM_DEV_BT=__SET_BY_OPS__
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${FILE_DEV_BT},${PM_DEV_BT}
# 与 SERVICE_BOOTSTRAP_TOKENS 等长并行，service-jwt sub=<owner>（审计归属）
SERVICE_BOOTSTRAP_OWNERS=iam-service,token-service,notification-service,audit-service,prue_backend,api-gateway,file-service,pm-api
