# local dev values (gitignored; server keeps its own copy)
# 2026-11-06 起 infra + observability 组部署在 192.168.2.10（跨主机模式 C）：
# 本机只跑 services 组与 ai-pm 自有服务，中间件/主库一律走远端 LAN IP。
# 端口中 PG 用 5436（remote 片发布的宿主端口），Redis/RabbitMQ/Consul 与容器端口同号。
INFRA_HOST=192.168.2.10
# 本机 LAN IP：consul 健康检查回拨地址（跨机必须显式声明）
SERVICE_ADDRESS=192.168.2.4

POSTGRES_HOST=${INFRA_HOST}
POSTGRES_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=coder
POSTGRES_DB=coder
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
REDIS_HOST=${INFRA_HOST}
REDIS_PORT=6379
RABBITMQ_HOST=${INFRA_HOST}
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CONSUL_HOST=${INFRA_HOST}
CONSUL_ADDR=http://${INFRA_HOST}:8500
# otel-collector（observability 组）OTLP gRPC 宿主端口 4317
OTEL_ENDPOINT=http://${INFRA_HOST}:4317
# TOKEN_SERVICE_URL / JWKS_URL / TENANT_ID 已移 .env-infra（lmms 栈内常量）
AI_PM_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.2.4
# 首管理员对：命中的登录主体首次接入即 active + 库内 owner（runbook §5.3）
AI_PM_FIRST_ADMIN_TENANT=1
AI_PM_FIRST_ADMIN_SUBJECT=ms43SgeYv2qlY5HgVaJGW
AI_PM_PUBLIC_BASE_URL=http://127.0.0.1:8091
# SSH 部署密钥封私钥主密钥（值必须稳定，换值=已封私钥不可解；与 2026-11-05 E2E 批一致）
AI_PM_SECRET_KEY=dev-aipm-local-secret-1
IAM_DEV_BT=local-dev-bt-iam
TOKEN_DEV_BT=local-dev-bt-token
NOTIFICATION_DEV_BT=local-dev-bt-notification
AUDIT_DEV_BT=local-dev-bt-audit
PRUE_DEV_BT=local-dev-bt-prue
GATEWAY_DEV_BT=local-dev-bt-gateway
FILE_DEV_BT=local-dev-bt-file
PM_DEV_BT=__SET_BY_OPS__
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${FILE_DEV_BT},${PM_DEV_BT}
# 与 SERVICE_BOOTSTRAP_TOKENS 等长并行，service-jwt sub=<owner>（审计归属）
SERVICE_BOOTSTRAP_OWNERS=iam-service,token-service,notification-service,audit-service,prue_backend,api-gateway,file-service,pm-api
