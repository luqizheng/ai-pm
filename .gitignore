/target
# clippy 专用 target 目录（scripts/clippy.sh 使用，与 dev 产物隔离）
/.target-clippy/
.env
/node_modules
/.superpowers/
run-workspaces/
# 本地运行时产物（dev 服务日志 / knowledge git 根 / repo clone 缓存）
/logs/
/data/
# compose 的 bind mount 目录（../services/iam-service/config 为 rw 挂载，
# iam-service 首次启动自播种 config.yaml —— 运行时产物，不入库）
/services/iam-service/

# 本地预览产物（截图 / 临时目录）
ai-ai-frontend/.testtmp/__pycache__/
__pycache__/
.test-env.md
# 前端误跑 tsc 产生的编译产物（源码是 .ts / .vue，同目录 .js/.js.map 不入库；
# 2026-11-10 清理 1060 个误生成文件后加护栏）
ai-frontend/src/**/*.js
ai-frontend/src/**/*.js.map
ai-frontend/build/**/*.js
ai-frontend/build/**/*.js.map

# 本机部署/工具目录
/docker-deploy/
/.zcode/

# E2E 执行日志（每次跑按时间戳落盘；不入库，结论进 test-case/*.md）
test-case/evidence/e2e-flow/*.log
test-case/evidence/e2e-flow/e2e-nextest-*.log
