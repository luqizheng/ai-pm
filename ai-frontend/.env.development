# 本地运行端口号
VITE_PORT = 8848

# 开发环境 API 基础路径（经 vite 代理转发到 pm-api，代理目标见 vite.config.ts）
VITE_API_BASE = /api

# lmms IAM SDK（iam-services）的网关前缀：vite 代理 /gw → LMMS_GATEWAY_URL
# （默认 http://127.0.0.1:3000）；IAM 登录/用户调用走这里，pm 业务仍走 VITE_API_BASE
VITE_IAM_BASE_URL = /gw

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 开发环境路由历史模式：hash（Hash）/ h5（HTML5 history），可逗号附加 base，如 h5,/sub
VITE_ROUTER_HISTORY = "h5"

# 置 1 时 vite dev server 用内置 mock 响应壳与业务的全部端点（见 build/mock-plugin.ts），
# pm-api 未实现路由前的本地预览开关；接真实后端时置 0 或删除本行
VITE_USE_MOCK = 1
