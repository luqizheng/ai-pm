# 线上环境平台打包路径
VITE_PUBLIC_PATH = /

# 线上环境 API 基础路径（同域部署可留空字符串）
VITE_API_BASE = /api

# 线上环境 lmms 基础服务（iam/audit/config/file/notification/prue）SDK 前缀。
# 与 VITE_API_BASE 合并为 /api：边缘（nginx）只剥 /api 转 api-gateway，
# 网关按 /v1/pm 与 /v1/iam|auth|audit|... 分流，不再需要独立的 /gw 反代块。
VITE_IAM_BASE_URL = /api

# 线上环境路由历史模式：hash（Hash）/ h5（HTML5 history），可逗号附加 base，如 h5,/sub
VITE_ROUTER_HISTORY = "h5"
