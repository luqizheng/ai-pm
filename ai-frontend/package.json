{
  "name": "ai-pm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-PM 平台前端 —— PRISM 壳 + 项目管理业务视图",
  "scripts": {
    "dev": "node ../scripts/sync-vditor-assets.js && NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "pnpm run build:packages && node ../scripts/sync-vditor-assets.js && rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "pnpm run build:packages && node ../scripts/sync-vditor-assets.js && rimraf dist && vite build --mode staging",
    "build:packages": "pnpm --filter @digua/contracts --filter @digua/http run build",
    "sync:vditor": "node ../scripts/sync-vditor-assets.js",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "pnpm run build:packages && vue-tsc --noEmit --skipLibCheck",
    "check:prism-tokens": "node ../scripts/check-prism-tokens.js",
    "check:i18n": "node ../scripts/check-i18n-namespace.js && node ../scripts/check-i18n-hardcode.js",
    "check:viz": "bash ../scripts/check-viz.sh",
    "test:unit": "pnpm run build:packages && vitest run --reporter=verbose",
    "test:unit:watch": "vitest",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0 src build",
    "lint:prettier": "prettier --check \"src/**/*.{js,ts,json,tsx,css,vue,html,md}\"",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "ai-pm",
    "prism",
    "vue3",
    "design-system"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@digua/contracts": "workspace:*",
    "@digua/http": "workspace:*",
    "audit-services": "1.10.1",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "config-services": "1.10.1",
    "file-services": "1.10.1",
    "iam-services": "1.10.1",
    "lucide-vue-next": "^1.0.0",
    "notification-services": "1.10.1",
    "pinia": "^3.0.4",
    "prue-services": "1.10.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vditor": "^4.0.1",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.10",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11"
  }
}
